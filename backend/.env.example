# Database (Supabase PostgreSQL - just change this URL to switch databases)
# Required by the NestJS app AND by the maintenance scripts in backend/
# (check-db.js, check-tables.js, create-tables.js, debug-insert.js, list-all.js,
# reset-and-seed.js, run-migration.js, seed-data.js, seed-shop.js, test-neon.js).
# Those scripts exit with an error if it is unset - they have no built-in fallback.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Direct (non-pooled) connection. prisma/schema.prisma declares
# directUrl = env("DIRECT_URL"), so every Prisma CLI command - generate,
# migrate, db push - fails with P1012 when this is missing. With a pooler,
# point DATABASE_URL at the pooled port and DIRECT_URL at the direct one;
# without a pooler the two are the same value.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret (keep this for existing auth, will be replaced by Supabase Auth)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789

# NOTE: the NestJS app does not load this file. src/app.module.ts does not
# register @nestjs/config's ConfigModule, so the server reads process.env
# directly and every variable below must be exported in the shell (or supplied
# by your host's environment settings). Only the standalone maintenance
# scripts read backend/.env, via dotenv in db-client.js.

# Server
PORT=3001
NODE_ENV=development

# Supabase (for auth verification and realtime)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# App
APP_NAME=CaféOS
