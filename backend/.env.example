# Database (Supabase PostgreSQL - just change this URL to switch databases)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret — REQUIRED in production.
# Must be a strong random value of at least 16 characters. The server refuses to
# boot with NODE_ENV=production if this is unset, a known placeholder, or shorter
# than 16 chars. Generate one with:  openssl rand -hex 32
# Outside production a random per-process secret is used, so dev tokens stop
# working on every restart until you set this.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789

# Server
PORT=3001
NODE_ENV=development

# Supabase (for auth verification and realtime)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# App
APP_NAME=CaféOS
